# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/ai-accountant
# Alias supported by the new bootstrap utility
MONGO_URI=mongodb://localhost:27017/ai-accountant
# Optional fallback used by local development if the primary URI is unavailable
MONGODB_FALLBACK_URI=mongodb://127.0.0.1:27017/ai-accountant
# Explicitly allow the backend to start without MongoDB (disabled by default)
ALLOW_DEGRADED_MODE=false
# Retry tuning for MongoDB bootstrap
MONGODB_RETRY_ATTEMPTS=3
MONGODB_RETRY_BASE_DELAY_MS=500
# Optional Redis health reporting
REDIS_URL=

# JWT Secret (Generate a secure random string)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API Keys
GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Client URL (Frontend)
CLIENT_URL=http://localhost:5173

# Frontend URL used in password reset emails (link target)
FRONTEND_URL=http://localhost:5173

# Password reset token TTL in minutes
RESET_PASSWORD_TOKEN_TTL_MINUTES=60

# Email Configuration (password reset)
# Option A — Gmail with an App Password (easiest). Create one at
#   https://myaccount.google.com/apppasswords  (requires 2-Step Verification).
# Paste the 16-character password; spaces are fine.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Option B — Generic SMTP (any provider). Used only if GMAIL_* is not set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
# From address shown on the email (defaults to GMAIL_USER / SMTP_USER).
SMTP_FROM=no-reply@yourdomain.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
